# OMI — Environment Configuration
# Copy this file to .env and edit values before running.
#
# This repo has THREE independent .env files — this one, omi-deepdive/.env, and
# omi-benchmarks/.env — one per app. They share many variable names (PORT, ENV,
# SECRET_KEY, ADMIN_KEY, DB_*) but each app only ever reads its own file, so the
# same name means a different value in each. Editing this one has no effect on
# the other two apps, even though they look identical at a glance.

# ─── Environment ──────────────────────────────────────────────────────────────
# development  → SQLite DB, emails print to terminal, debug mode on
# production   → MySQL DB, Gmail API email, debug mode off
ENV=development

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-prod
PORT=5050

# ─── Database (development) ───────────────────────────────────────────────────
# Filename relative to project root
SQLITE_PATH=local_dev.db

# ─── Database (production) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=omi_user
DB_PASS=changeme
DB_NAME=omi_db

# ─── Email (production only) ──────────────────────────────────────────────────
# base64-encode your Google service account JSON and paste here:
#   base64 -w 0 service_account.json
# The service account needs domain-wide delegation with Gmail send scope.
GMAIL_SA_CREDENTIALS_JSON=
GMAIL_SENDER=info@vunetsystems.com

# ─── Benchmarks service (peer comparison) ─────────────────────────────────────
# omi-benchmarks is a separate app (see ../omi-benchmarks). Leave BENCHMARKS_URL
# blank to run OMI without it — the peer-comparison card simply won't render.
BENCHMARKS_URL=http://localhost:5070
BENCHMARKS_API_KEY=
