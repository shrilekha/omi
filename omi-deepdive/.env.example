# omi-deepdive — Environment Configuration
# Copy this file to .env and edit values before running.
#
# IMPORTANT: this must point to its OWN database, separate from OMI's
# production database (omi_db). It holds real client tool-stack and
# capability-gap data across multiple accounts and must not share
# infrastructure or credentials with the public-facing OMI survey app.

# ─── Environment ──────────────────────────────────────────────────────────────
# development  → SQLite DB, debug mode on
# production   → MySQL DB, debug mode off
ENV=development

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-prod
PORT=5060

# ─── Admin ────────────────────────────────────────────────────────────────────
# Password gate for /admin — the only unauthenticated-by-default page that can
# create data. Per-app and per-report links stay secured by their own unguessable
# tokens regardless of this value. Change this before any shared/production use.
ADMIN_KEY=changeme-admin-password

# ─── Admin login: Google OAuth (optional) ─────────────────────────────────────
# Leave both blank to keep the ADMIN_KEY password login above (the default).
# Fill in both to SWAP admin login to "Sign in with Google" instead — the
# password form is disabled once these are set, not left as a parallel option.
# No new pip install needed either way; this is implemented with the Python
# standard library directly against Google's OAuth endpoints.
#
# Setup:
#   1. https://console.cloud.google.com/apis/credentials -> Create Credentials
#      -> OAuth client ID -> Application type: Web application.
#   2. Authorized redirect URI: <your-deployed-base-url>/admin/google/callback
#      (e.g. https://omi-deepdive.yourdomain.com/admin/google/callback)
#   3. Paste the generated client ID/secret below and restart the app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional but recommended: only allow sign-in from this Google Workspace
# domain (checked server-side against the verified email, not just requested
# as a UI hint). Leave blank to allow any Google account.
GOOGLE_OAUTH_ALLOWED_DOMAIN=vunetsystems.com

# ─── RBAC bootstrap (only used once Google OAuth is enabled above) ────────────
# admin_users (in the database) is the source of truth for who has which role
# once at least one row exists — but that table starts empty, so something has
# to grant the very first admin. Comma-separated emails here are auto-granted
# the 'admin' role the first time they sign in with Google, if they don't
# already have a row in admin_users. Safe to leave set permanently — it only
# ever creates a row, never overrides one that already exists, so removing
# someone's access later means editing/deactivating them in /admin/users, not
# just deleting them from this list.
INITIAL_ADMIN_EMAILS=

# ─── Database (development) ───────────────────────────────────────────────────
# Filename relative to project root
SQLITE_PATH=local_dev.db

# ─── Database (production) ────────────────────────────────────────────────────
# Use a dedicated database/instance — do not reuse OMI's omi_db.
DB_HOST=localhost
DB_USER=deepdive_user
DB_PASS=changeme
DB_NAME=omi_deepdive_db

# ─── Benchmarks service (peer comparison) ─────────────────────────────────────
# omi-benchmarks is a separate app (see ../omi-benchmarks). Leave BENCHMARKS_URL
# blank to run without it — reports simply won't show a peer comparison.
BENCHMARKS_URL=http://localhost:5070
BENCHMARKS_API_KEY=
