# omi-deepdive — Environment Configuration
# Copy this file to .env and edit values before running.
#
# IMPORTANT: this must point to its OWN database, separate from OMI's
# production database (omi_db). It holds real client tool-stack and
# capability-gap data across multiple accounts and must not share
# infrastructure or credentials with the public-facing OMI survey app.

# ─── Environment ──────────────────────────────────────────────────────────────
# development  → SQLite DB, debug mode on
# production   → MySQL DB, debug mode off
ENV=development

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-prod
PORT=5060

# ─── Admin ────────────────────────────────────────────────────────────────────
# Password gate for /admin — the only unauthenticated-by-default page that can
# create data. Per-app and per-report links stay secured by their own unguessable
# tokens regardless of this value. Change this before any shared/production use.
ADMIN_KEY=changeme-admin-password

# ─── Links printed by seed.py ─────────────────────────────────────────────────
# Base URL used when printing per-app and report links after seeding.
BASE_URL=http://localhost:5060

# ─── Database (development) ───────────────────────────────────────────────────
# Filename relative to project root
SQLITE_PATH=local_dev.db

# ─── Database (production) ────────────────────────────────────────────────────
# Use a dedicated database/instance — do not reuse OMI's omi_db.
DB_HOST=localhost
DB_USER=deepdive_user
DB_PASS=changeme
DB_NAME=omi_deepdive_db
