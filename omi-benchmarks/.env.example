# omi-benchmarks — Environment Configuration
# Copy this file to .env and edit values before running.
#
# This repo has THREE independent .env files — this one, ../.env (OMI), and
# ../omi-deepdive/.env — one per app. They share many variable names (PORT,
# ENV, SECRET_KEY, ADMIN_KEY, DB_*) but each app only ever reads its own file,
# so the same name means a different value in each. Editing this one has no
# effect on the other two apps, even though they look identical at a glance.

# ─── Environment ──────────────────────────────────────────────────────────────
# development  → SQLite DB, debug mode on
# production   → MySQL DB, debug mode off
ENV=development

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-prod
PORT=5070

# Password for the /admin benchmark-entry UI (leadership / customer success).
# There's no per-user identity here, same tradeoff OMI and omi-deepdive both
# started with — anyone with this key has full add/edit/delete access.
ADMIN_KEY=changeme-admin-password

# Shared secret OMI's and omi-deepdive's backends send as the X-Api-Key header
# when calling GET /api/benchmarks. This is a server-to-server call only —
# never exposed to either app's browser-facing pages. Leaving this blank in
# dev disables the check; it must be set in production.
BENCHMARKS_API_KEY=

# ─── Database (development) ───────────────────────────────────────────────────
SQLITE_PATH=local_dev.db

# ─── Database (production) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=benchmarks_user
DB_PASS=changeme
DB_NAME=omi_benchmarks_db
